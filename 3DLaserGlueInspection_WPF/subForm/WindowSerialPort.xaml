<Window x:Class="_3DLaserGlueInspection.subForm.WindowSerialPort"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resx="clr-namespace:_3DLaserGlueInspection.Resources"
        Title="PI 串口通讯设置" Width="1040" Height="720" MinWidth="920" MinHeight="640"
        FontFamily="Microsoft YaHei" FontSize="14" Background="#FF242B35" Foreground="White"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded"
        Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Foreground" Value="#FF202630"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF526070"/>
                    <Setter Property="Background" Value="#FFE0E4E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Foreground" Value="#FF202630"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF526070"/>
                    <Setter Property="Background" Value="#FFE0E4E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF263851"/>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#FF334C6E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="#FF203045"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="buttonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CommunicationLogStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="#FF1B222C"/>
            <Setter Property="Foreground" Value="#FFE3EBF5"/>
            <Setter Property="BorderBrush" Value="#FF48576A"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="#FF48576A" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="串口通讯参数" FontWeight="Bold" Margin="0,0,0,12"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                    <Ellipse x:Name="connectionIndicator" Width="10" Height="10" Fill="#FF9CA9B8" Margin="0,0,8,0"/>
                    <TextBlock x:Name="connectionStatusText" Text="未连接" Foreground="#FFB9C5D3"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="parametersPanel" Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/><RowDefinition Height="36"/>
                            <RowDefinition Height="36"/><RowDefinition Height="36"/>
                            <RowDefinition Height="36"/><RowDefinition Height="36"/>
                            <RowDefinition Height="36"/><RowDefinition Height="36"/>
                            <RowDefinition Height="34"/><RowDefinition Height="34"/>
                            <RowDefinition Height="34"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="串口号："/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="portNameComboBox" IsEditable="True" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="刷新" Margin="6,0,0,0" Padding="3,0" Click="RefreshPorts_Click"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="波特率："/>
                        <ComboBox x:Name="baudRateComboBox" Grid.Row="1" Grid.Column="1" IsEditable="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Text="数据位："/>
                        <ComboBox x:Name="dataBitsComboBox" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Text="校验位："/>
                        <ComboBox x:Name="parityComboBox" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Text="停止位："/>
                        <ComboBox x:Name="stopBitsComboBox" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Text="流控："/>
                        <ComboBox x:Name="handshakeComboBox" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="6" Text="读超时(ms)："/>
                        <TextBox x:Name="readTimeoutTextBox" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" ToolTip="1 ~ 1000 ms"/>
                        <TextBlock Grid.Row="7" Text="写超时(ms)："/>
                        <TextBox x:Name="writeTimeoutTextBox" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" ToolTip="1 ~ 5000 ms"/>
                        <CheckBox x:Name="dtrEnableCheckBox" Grid.Row="8" Grid.ColumnSpan="2" Content="启用 DTR"/>
                        <CheckBox x:Name="rtsEnableCheckBox" Grid.Row="9" Grid.ColumnSpan="2" Content="启用 RTS" ToolTip="使用 RTS 硬件流控时由串口自动控制"/>
                        <CheckBox x:Name="sumIncludesETXCheckBox" Grid.Row="10" Grid.ColumnSpan="2" Content="SUM 同时包含 ETX"/>
                        <TextBlock Grid.Row="11" Grid.ColumnSpan="2" FontSize="12" Foreground="#FFB9C5D3" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="ASCII  /  STX：02  /  ETX：03&#x0a;SUM 固定包含 STX，累加低 8 位转 ASCII HEX。&#x0a;修改通讯参数前请先断开连接。"/>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="connectButton" Content="{x:Static resx:LanguageDict.Connect}" Click="Connect_Click"/>
                        <Button x:Name="disconnectButton" Grid.Column="2" Content="{x:Static resx:LanguageDict.Disconnect}" Click="Disconnect_Click" IsEnabled="False"/>
                    </Grid>
                    <Button x:Name="saveButton" Content="保存参数" Margin="0,10,0,0" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/><RowDefinition Height="*"/>
                <RowDefinition Height="40"/><RowDefinition Height="*"/>
                <RowDefinition Height="36"/><RowDefinition Height="104"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button Content="清空记录" DockPanel.Dock="Right" Width="94" Height="26" Click="ClearLogs_Click"/>
                <TextBlock x:Name="receiveCountText" Text="接收（0 条）" FontWeight="Bold" Foreground="#FF93D8B3"/>
            </DockPanel>
            <TextBox x:Name="receiveLogTextBox" Grid.Row="1" Style="{StaticResource CommunicationLogStyle}" Foreground="#FFB4E5C8"/>
            <TextBlock x:Name="sendCountText" Grid.Row="2" Text="发送（0 条）" FontWeight="Bold" Foreground="#FF94C3F2"/>
            <TextBox x:Name="sendLogTextBox" Grid.Row="3" Style="{StaticResource CommunicationLogStyle}" Foreground="#FFB8D8F8"/>
            <TextBlock Grid.Row="4" Text="操作信息" FontWeight="Bold"/>
            <TextBox x:Name="statusLogTextBox" Grid.Row="5" Style="{StaticResource CommunicationLogStyle}" FontFamily="Microsoft YaHei"/>
        </Grid>
    </Grid>
</Window>
