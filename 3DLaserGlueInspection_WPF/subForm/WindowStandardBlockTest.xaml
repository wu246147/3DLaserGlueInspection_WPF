<Window x:Class="_3DLaserGlueInspection.subForm.WindowStandardBlockTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3DLaserGlueInspection.subForm"
        xmlns:resx="clr-namespace:_3DLaserGlueInspection.Resources"
        mc:Ignorable="d"
        Title="{x:Static resx:LanguageDict.StandardBlockTest}"
        Width="1280" Height="850" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#FF242B35"
        Loaded="WindowStandardBlockTest_Loaded"
        Closing="WindowStandardBlockTest_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/Styles/DefaultStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PanelGroupBoxStyle" TargetType="GroupBox">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#FF2A3440" />
                <Setter Property="BorderBrush" Value="#FF59636F" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Padding" Value="8,10,8,10" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="PanelLabelStyle" TargetType="Label">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="PanelTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FF263851" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#FFDDDDDD" />
            </Style>
            <Style x:Key="PanelComboBoxStyle" TargetType="ComboBox">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Background" Value="#FF263851" />
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="BorderBrush" Value="#FFDDDDDD" />
            </Style>
            <Style x:Key="PanelButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#FF263851" />
                <Setter Property="BorderBrush" Value="#FFDDDDDD" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="#FF242B35">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="380" />
            <RowDefinition Height="220" MinHeight="180" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="520" />
            <ColumnDefinition Width="430" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="5" Background="#FF2A3440">
            <local:ImageControl2 x:Name="hWindowModel" />
        </Border>
        <Border Grid.Row="1" Grid.Column="0" Margin="5" Background="#FF2A3440">
            <DataGrid x:Name="DataGridLog" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" AlternationCount="2"
                      GridLinesVisibility="None" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Hidden" Background="Transparent" BorderThickness="0"
                      ItemsSource="{Binding LogRecords}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      RowStyle="{StaticResource LogDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static resx:LanguageDict.Time}"
                                        Binding="{Binding LogTime}"
                                        Width="200" Foreground="White" />
                    <DataGridTemplateColumn Header="{x:Static resx:LanguageDict.Info}"
                                            CellTemplate="{StaticResource TextDataTemplate}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="5"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="{x:Static resx:LanguageDict.StandardBlockSelection}" Style="{StaticResource PanelGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" Content="{x:Static resx:LanguageDict.CarType}" Style="{StaticResource PanelLabelStyle}" />
                        <ComboBox x:Name="carNameComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                                  Style="{StaticResource PanelComboBoxStyle}" SelectionChanged="carNameComboBox_SelectionChanged" />
                        <Label Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" Content="{x:Static resx:LanguageDict.CamName}" Style="{StaticResource PanelLabelStyle}" />
                        <ComboBox x:Name="cameraComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                  Style="{StaticResource PanelComboBoxStyle}" DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Key" SelectionChanged="cameraComboBox_SelectionChanged" />
                        <Label Grid.Row="2" Grid.Column="0" Margin="0,0,12,0" Content="{x:Static resx:LanguageDict.StandardBlockCamera}" Style="{StaticResource PanelLabelStyle}" />
                        <TextBlock x:Name="physicalCameraTextBlock" Grid.Row="2" Grid.Column="1"
                                   Foreground="#FFD5DCE3" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{x:Static resx:LanguageDict.StandardBlockAcquisition}" Style="{StaticResource PanelGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="openCamButton" Grid.Row="0" Grid.Column="0"
                                Content="{x:Static resx:LanguageDict.OpenCam}" Style="{StaticResource PanelButtonStyle}"
                                Click="openCamButton_Click" />
                        <Button x:Name="closeCamButton" Grid.Row="0" Grid.Column="1"
                                Content="{x:Static resx:LanguageDict.CloseCam}" Style="{StaticResource PanelButtonStyle}"
                                Click="closeCamButton_Click" />
                        <Button x:Name="singleCheckButton" Grid.Row="1" Grid.Column="0"
                                Content="{x:Static resx:LanguageDict.SingleAcq}" Style="{StaticResource PanelButtonStyle}"
                                Click="singleCheckButton_Click" />
                        <Button x:Name="detectButton" Grid.Row="1" Grid.Column="1"
                                Style="{StaticResource PanelButtonStyle}" Click="detectButton_Click">
                            <TextBlock Text="{x:Static resx:LanguageDict._3DGluingFrameDetection}"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                    </Grid>
                </GroupBox>

                <GroupBox Header="{x:Static resx:LanguageDict.StandardBlockMeasurement}" Style="{StaticResource PanelGroupBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" Content="{x:Static resx:LanguageDict.StandardBlockContourThreshold}" Style="{StaticResource PanelLabelStyle}" />
                        <TextBox x:Name="thresholdTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,10" TextChanged="thresholdTextBox_TextChanged" />
                        <Label Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" Content="{x:Static resx:LanguageDict.GlueWidth}" Style="{StaticResource PanelLabelStyle}" />
                        <TextBox x:Name="widthRangeTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,10" />
                        <Label Grid.Row="2" Grid.Column="0" Margin="0,0,12,10" Content="{x:Static resx:LanguageDict.GlueHeight}" Style="{StaticResource PanelLabelStyle}" />
                        <TextBox x:Name="heightRangeTextBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,10" />
                        <Label Grid.Row="3" Grid.Column="0" Margin="0,0,12,10" Content="{x:Static resx:LanguageDict.Area}" Style="{StaticResource PanelLabelStyle}" />
                        <TextBox x:Name="areaRangeTextBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Style="{StaticResource PanelTextBoxStyle}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{x:Static resx:LanguageDict.StandardBlockRangeReadOnly}"
                                   Foreground="#FFB9C3CF" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{x:Static resx:LanguageDict.DetResult}" Style="{StaticResource PanelGroupBoxStyle}">
                    <TextBlock x:Name="resultStatusTextBlock" Text="{x:Static resx:LanguageDict.StandardBlockReady}"
                               Foreground="#FFD5DCE3" FontSize="14" TextWrapping="Wrap" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
