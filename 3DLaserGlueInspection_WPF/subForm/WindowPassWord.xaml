<Window x:Class="_3DLaserGlueInspection.subForm.WindowPassWord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3DLaserGlueInspection.subForm"
        xmlns:tool ="clr-namespace:_3DLaserGlueInspection.tool"
        mc:Ignorable="d"
                    xmlns:resx="clr-namespace:_3DLaserGlueInspection.Resources"
        Title="{x:Static resx:LanguageDict.PleaseInputPassWord}" Height="250" Width="450" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/Styles/DefaultStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#FF242B35">
        <Button  x:Name="ensureButton" Content="{x:Static resx:LanguageDict.Sure}"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" Width="120" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="57,0,0,31" Click="ensureButton_Click" MouseDown="ensureButton_MouseDown" Height="24" VerticalAlignment="Bottom"  />
        <Button  x:Name="cancelButton" Content="{x:Static resx:LanguageDict.Cancel}"      FontSize="14" Foreground="White" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="0,0,57,31" Click="cancelButton_Click" HorizontalAlignment="Right" Width="120" Height="24" VerticalAlignment="Bottom"  />
        <Label  Content="{x:Static resx:LanguageDict.PassWord}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="47,72,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>
        <TextBox Style="{StaticResource TxtPwd}" x:Name="passWordNumericUpDown" FontSize="14" Margin="139,69,58,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="" KeyDown="passWordNumericUpDown_KeyDown" />
        <Label Name="tipLabel"  Content="    " FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="139,117,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>
    </Grid>
</Window>
