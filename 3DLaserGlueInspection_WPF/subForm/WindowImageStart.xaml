<Window x:Class="_3DLaserGlueInspection.subForm.WindowImageStart"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:_3DLaserGlueInspection.subForm"
        Title="设置涂胶对齐起点" Width="960" Height="660" MinWidth="760" MinHeight="550"
        WindowStartupLocation="CenterOwner" Background="#FF242B35" Foreground="White">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/Styles/DefaultStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="scopeText" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
            <TextBlock Text="起点参数 ID：" VerticalAlignment="Center"/>
            <TextBox x:Name="parameterIdTextBox" Width="90" Margin="4,0,20,0" TextChanged="selectionTextBox_TextChanged"/>
            <TextBlock Text="起点实际图片 ID：" VerticalAlignment="Center"/>
            <TextBox x:Name="actualImageIdTextBox" Width="90" Margin="4,0,8,0" TextChanged="selectionTextBox_TextChanged"/>
            <Button Content="上一张" Width="65" Margin="0,0,6,0" Click="previousImageButton_Click"/>
            <Button Content="下一张" Width="65" Click="nextImageButton_Click"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <GroupBox Header="前一张实际图片 A" Foreground="White">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <local:ImageControl2 x:Name="previousImagePreview"/>
                    <TextBlock x:Name="previousPoseText" Grid.Row="1" TextWrapping="Wrap" Margin="6"/>
                </Grid>
            </GroupBox>
            <GroupBox Header="起点实际图片 B" Foreground="White" Grid.Column="2">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <local:ImageControl2 x:Name="startImagePreview"/>
                    <TextBlock x:Name="startPoseText" Grid.Row="1" TextWrapping="Wrap" Margin="6"/>
                </Grid>
            </GroupBox>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="rangeText" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBlock Grid.Row="4" x:Name="bindingText" TextWrapping="Wrap" Margin="0,10,0,12"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="applyButton" Content="应用起点并重新对齐" Padding="12,5" Margin="0,0,12,0" Click="applyButton_Click"/>
            <Button Content="取消" Padding="18,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
