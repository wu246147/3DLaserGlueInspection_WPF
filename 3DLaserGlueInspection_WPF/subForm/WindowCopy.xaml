<Window x:Class="_3DLaserGlueInspection.subForm.WindowCopy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3DLaserGlueInspection.subForm"
            xmlns:resx="clr-namespace:_3DLaserGlueInspection.Resources"
        mc:Ignorable="d"
        Title="{x:Static resx:LanguageDict.Copy}" Height="200" Width="350
        ">
    <Grid Background="#FF242B35">
        <Button  x:Name="ensureButton" Content="{x:Static resx:LanguageDict.Sure}"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" Width="104" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="42,0,0,31" Click="ensureButton_Click" Height="24" VerticalAlignment="Bottom"  />
        <Button  x:Name="cancelButton" Content="{x:Static resx:LanguageDict.Cancel}"      FontSize="14" Foreground="White" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="0,0,42,31" Click="cancelButton_Click" Height="24" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="103"  />
        <Label  Content="{x:Static resx:LanguageDict.StartPoint}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="33,31,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>
        <Label  Content="{x:Static resx:LanguageDict.EndPoint}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="33,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.558,0.963"/>
        <TextBox x:Name="startIDNumericUpDown" FontSize="14" Margin="132,35,42,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />
        <TextBox x:Name="endIDNumericUpDown" FontSize="14" Margin="132,0,42,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Center" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />

    </Grid>
</Window>
