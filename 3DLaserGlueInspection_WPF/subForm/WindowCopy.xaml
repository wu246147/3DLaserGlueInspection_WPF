<Window x:Class="_3DLaserGlueInspection.subForm.WindowCopy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3DLaserGlueInspection.subForm"
        mc:Ignorable="d"
        Title="复制" Height="200" Width="270">
    <Grid Background="#FF242B35">
        <Button  x:Name="ensureButton" Content="确定"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" Width="70" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="42,144,0,0" Click="ensureButton_Click" Height="24" VerticalAlignment="Top"  />
        <Button  x:Name="cancelButton" Content="取消"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" Width="70" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="158,144,0,0" Click="cancelButton_Click" Height="24" VerticalAlignment="Top"  />
        <Label  Content="起点：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="33,31,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>
        <Label  Content="终点：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="33,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.558,0.963"/>
        <TextBox x:Name="startIDNumericUpDown" FontSize="14"  HorizontalAlignment="Left" Margin="90,35,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="138" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />
        <TextBox x:Name="endIDNumericUpDown" FontSize="14"  HorizontalAlignment="Left" Margin="90,0,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Center" Width="138" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />

    </Grid>
</Window>
