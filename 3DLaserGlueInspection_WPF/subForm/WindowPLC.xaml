<Window x:Class="_3DLaserGlueInspection.subForm.WindowPLC"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:_3DLaserGlueInspection.subForm"
        xmlns:resx="clr-namespace:_3DLaserGlueInspection.Resources"
        mc:Ignorable="d"
        Title="PLC设置" Height="575" Width="814" ResizeMode="NoResize" Loaded="WindowPLC_Load" Closing="WindowPLC_Closing">
    <Grid  Background="#FF242B35">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150*"/>
            <ColumnDefinition Width="150*"/>
            <ColumnDefinition Width="100*"/>

        </Grid.ColumnDefinitions>
        <Grid x:Name="inputGrip" Margin="5,5,5,5">
            <Label Name="inputNameLabel"  Content="{x:Static resx:LanguageDict.SignalName}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="77"/>
            <Label Name="inputDirLabel"   Content="{x:Static resx:LanguageDict.Registers}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="100,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>
            <Label Name="inputValueLabel" Content="{x:Static resx:LanguageDict.Val}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="180,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>

        </Grid>

        <Grid x:Name="outputGrip"  Grid.Column="1" Margin="5,5,5,5" >
            <Label Name="outputNameLabel"   Content="{x:Static resx:LanguageDict.SignalName}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="75"/>
            <Label Name="outputDirLabel"    Content="{x:Static resx:LanguageDict.Registers}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="100,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>
            <Label Name="outputValueLabel"  Content="{x:Static resx:LanguageDict.Val}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="180,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>

        </Grid>
        <Grid  Grid.Column="2" Margin="5,5,5,5" Background="#FF3C4451">
            <Label x:Name="IpLabel"  Content="Ip：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="5,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>
            <Label x:Name="PortLabel"  Content="Port：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="5,38,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>
            <TextBox x:Name="PortNumericUpDown" FontSize="14"  HorizontalAlignment="Left" Margin="55,43,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="129" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />
            <TextBox x:Name="IpNumericUpDown" FontSize="14"  HorizontalAlignment="Left" Margin="55,14,0,0" TextWrapping="Wrap" Text="192.168.2.152" VerticalAlignment="Top" Width="129" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />
            <Button  x:Name="connectButton" Content="{x:Static resx:LanguageDict.Connect}"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="80" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="10,172,0,0" Click="connectButton_Click" />
            <Button  x:Name="disconnectButton" Content="{x:Static resx:LanguageDict.Disconnect}"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="80" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="104,172,0,0" Click="disconnectButton_Click" />
            <Label x:Name="logLabel"  Content="{x:Static resx:LanguageDict.Info}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="10,206,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>
            <TextBox x:Name="logTextBox" FontSize="14"  HorizontalAlignment="Center" Margin="0,234,0,10" TextWrapping="Wrap" Text="" Width="174" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />
            <Label   Content="DA2：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="5,66,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>
            <TextBox x:Name="DA2NumericUpDown" FontSize="14"  HorizontalAlignment="Left" Margin="55,71,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="129" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />
            <CheckBox  x:Name="isStringReverseByteWordCheck" Content="字符按字反转" HorizontalAlignment="Left" Margin="10,138,0,0" VerticalAlignment="Top" FontSize="14" Foreground="White" Checked="isStringReverseByteWordCheck_Checked" Unchecked="isStringReverseByteWordCheck_Checked" />
            <ComboBox x:Name="dataFormatComboBox" FontSize="14"  BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="84,100,10,0" VerticalAlignment="Top" SelectionChanged="dataFormatComboBox_SelectionChanged"/>
            <Label  Content="数据格式："   FontSize="14" Foreground="White" Margin="7,100,114,422"/>

        </Grid>
    </Grid>
</Window>
