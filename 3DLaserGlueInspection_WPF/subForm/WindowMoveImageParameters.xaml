<Window x:Class="_3DLaserGlueInspection.subForm.WindowMoveImageParameters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resx="clr-namespace:_3DLaserGlueInspection.Resources"
        Title="图片参数移动" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#FF242B35" Foreground="White">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="scopeText" Grid.ColumnSpan="2" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="rangeHintText" Grid.Row="1" Grid.ColumnSpan="2" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
        <Label Grid.Row="2" Content="起始图片 ID：" Foreground="White" FontSize="14" VerticalAlignment="Center" />
        <TextBox x:Name="startIdTextBox" Grid.Row="2" Grid.Column="1" FontSize="14" VerticalAlignment="Center" InputMethod.IsInputMethodEnabled="False" />
        <Label Grid.Row="3" Content="结束图片 ID：" Foreground="White" FontSize="14" VerticalAlignment="Center" />
        <TextBox x:Name="endIdTextBox" Grid.Row="3" Grid.Column="1" FontSize="14" VerticalAlignment="Center" InputMethod.IsInputMethodEnabled="False" />
        <Label Grid.Row="4" Content="目标图片起始 ID：" Foreground="White" FontSize="14" VerticalAlignment="Center" />
        <TextBox x:Name="targetStartIdTextBox" Grid.Row="4" Grid.Column="1" FontSize="14" VerticalAlignment="Center" InputMethod.IsInputMethodEnabled="False" />
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="ensureButton" Content="{x:Static resx:LanguageDict.Sure}" IsDefault="True" Click="ensureButton_Click" Width="104" Height="28" FontSize="14" Foreground="White" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="0,0,25,0" />
            <Button Content="{x:Static resx:LanguageDict.Cancel}" IsCancel="True" Width="104" Height="28" FontSize="14" Foreground="White" BorderBrush="#FFDDDDDD" Background="#FF263851" />
        </StackPanel>
    </Grid>
</Window>
