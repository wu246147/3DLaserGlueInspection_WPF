<Window x:Class="_3DLaserGlueInspection.subForm.WindowNewPassWord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3DLaserGlueInspection.subForm"
                            xmlns:resx="clr-namespace:_3DLaserGlueInspection.Resources"
        mc:Ignorable="d"
        Title="{x:Static resx:LanguageDict.ChangePassWord}" Height="300" Width="450" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/Styles/DefaultStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#FF242B35">
        <Label Content="修改对象 :" FontSize="14" Foreground="White" HorizontalAlignment="Left" Margin="45,15,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="userTypeComboBox" FontSize="14" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="186,12,68,0" VerticalAlignment="Top" SelectionChanged="userTypeComboBox_SelectionChanged" SelectedIndex="0">
            <ComboBoxItem Content="管理员"/>
            <ComboBoxItem Content="超级管理员"/>
        </ComboBox>
        <Button  x:Name="ensureButton" Content="{x:Static resx:LanguageDict.Sure}"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" Width="100" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="87,0,0,36" Click="ensureButton_Click" Height="24" VerticalAlignment="Bottom" MouseDown="ensureButton_MouseDown"  />
        <Button  x:Name="cancelButton" Content="{x:Static resx:LanguageDict.Cancel}"      FontSize="14" Foreground="White" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="0,0,68,36" Click="cancelButton_Click" Height="24" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="100"  />
        <Label  Content="{x:Static resx:LanguageDict.OriginPassWord}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="45,55,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>
        <TextBox Style="{StaticResource TxtPwd}" x:Name="originPassWordNumericUpDown" FontSize="14" Margin="186,54,68,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" KeyDown="PassWordNumericUpDown_KeyDown"  />
        <Label  Content="{x:Static resx:LanguageDict.NewPassWord}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="45,95,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>
        <TextBox Style="{StaticResource TxtPwd}" x:Name="newPassWordNumericUpDown" FontSize="14" Margin="186,94,68,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" KeyDown="PassWordNumericUpDown_KeyDown" />
        <Label  Content="{x:Static resx:LanguageDict.RepeatPassWord}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="45,135,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>
        <TextBox Style="{StaticResource TxtPwd}" x:Name="repeatPassWordNumericUpDown" FontSize="14" Margin="186,134,68,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" KeyDown="PassWordNumericUpDown_KeyDown" />
        <Label x:Name="tipLabel"  Content="    " FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="186,175,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>

    </Grid>
</Window>
