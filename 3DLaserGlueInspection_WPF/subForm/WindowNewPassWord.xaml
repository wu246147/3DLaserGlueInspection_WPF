<Window x:Class="_3DLaserGlueInspection.subForm.WindowNewPassWord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3DLaserGlueInspection.subForm"
        mc:Ignorable="d"
        Title="修改密码" Height="250" Width="350" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Assets/Styles/DefaultStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#FF242B35">
        <Button  x:Name="ensureButton" Content="确定"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" Width="70" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="87,175,0,0" Click="ensureButton_Click" Height="24" VerticalAlignment="Top" MouseDown="ensureButton_MouseDown"  />
        <Button  x:Name="cancelButton" Content="取消"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" Width="70" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="203,175,0,0" Click="cancelButton_Click" Height="24" VerticalAlignment="Top"  />
        <Label  Content="原密码：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="64,16,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>
        <TextBox Style="{StaticResource TxtPwd}" x:Name="originPassWordNumericUpDown" FontSize="14"  HorizontalAlignment="Left" Margin="135,15,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="138" KeyDown="PassWordNumericUpDown_KeyDown"  />
        <Label  Content="新密码：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="64,55,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>
        <TextBox Style="{StaticResource TxtPwd}" x:Name="newPassWordNumericUpDown" FontSize="14"  HorizontalAlignment="Left" Margin="135,54,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="138" KeyDown="PassWordNumericUpDown_KeyDown" />
        <Label  Content="重复密码：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="64,97,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>
        <TextBox Style="{StaticResource TxtPwd}" x:Name="repeatPassWordNumericUpDown" FontSize="14"  HorizontalAlignment="Left" Margin="135,96,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="138" KeyDown="PassWordNumericUpDown_KeyDown" />
        <Label x:Name="tipLabel"  Content="    " FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="135,133,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.519,0.543"/>

    </Grid>
</Window>
