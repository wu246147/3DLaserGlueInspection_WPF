<Window x:Class="_3DLaserGlueInspection.subForm.WindowRobot3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3DLaserGlueInspection.subForm"
        xmlns:resx="clr-namespace:_3DLaserGlueInspection.Resources"
        mc:Ignorable="d"
        Title="{x:Static resx:LanguageDict.RobotSetting}" Height="836" Width="1175" ResizeMode="NoResize" Loaded="WindowRobot3_Load" Closing="WindowRobot3_Closing">
    <Grid Background="#FF242B35" Margin="0,0,0,-5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150*"/>
            <ColumnDefinition Width="150*"/>
            <ColumnDefinition Width="100*"/>

        </Grid.ColumnDefinitions>
        <Grid x:Name="inputGrip" Margin="5,5,5,5">
            <Label Name="inputNameLabel"  Content="{x:Static resx:LanguageDict.SignalName}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="77"/>
            <Label Name="inputDirLabel"   Content="{x:Static resx:LanguageDict.Registers}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White" Margin="189,10,190,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28"/>
            <Label Name="inputValueLabel" Content="{x:Static resx:LanguageDict.Val}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White" Margin="320,10,59,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28"/>

        </Grid>

        <Grid x:Name="outputGrip"  Grid.Column="1" Margin="5,5,5,5" >
            <Label Name="outputNameLabel"   Content="{x:Static resx:LanguageDict.SignalName}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="75"/>
            <Label Name="outputDirLabel"    Content="{x:Static resx:LanguageDict.Registers}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White" Margin="189,10,190,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28"/>
            <Label Name="outputValueLabel"  Content="{x:Static resx:LanguageDict.Val}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White" Margin="324,10,55,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28"/>

        </Grid>
        <Grid  Grid.Column="2" Margin="5,5,5,5" Background="#FF3C4451">
            <Button  x:Name="connectButton" Content="{x:Static resx:LanguageDict.Connect}"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="80" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="31,226,0,0" Click="connectButton_Click" />
            <Button  x:Name="disconnectButton" Content="{x:Static resx:LanguageDict.Disconnect}"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="80" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="125,226,0,0" Click="disconnectButton_Click" />
            <Label x:Name="logLabel"  Content="{x:Static resx:LanguageDict.Info}" ContentStringFormat="{}{0} :" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="6,264,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>
            <TextBox x:Name="logTextBox" FontSize="14"  HorizontalAlignment="Center" Margin="0,297,0,10" TextWrapping="Wrap" Text="" Width="174" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />
            <Label Content="机器人获取坐标通讯：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="150"/>
            <Label   Content="Ip：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="32,43,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>
            <Label   Content="Port：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="32,71,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="52"/>
            <TextBox x:Name="UDPPortNumericUpDown" FontSize="14"  HorizontalAlignment="Left" Margin="82,76,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="130" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />
            <TextBox x:Name="UDPIpNumericUpDown" FontSize="14"  HorizontalAlignment="Left" Margin="82,47,0,0" TextWrapping="Wrap" Text="192.168.2.152" VerticalAlignment="Top" Width="130" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBox_PreviewTextInput" />
            <Button  x:Name="UDPconnectButton" Content="{x:Static resx:LanguageDict.Connect}"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="80" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="31,108,0,0" Click="UDPconnectButton_Click" />
            <Button  x:Name="UDPdisconnectButton" Content="{x:Static resx:LanguageDict.Disconnect}"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="80" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="125,108,0,0" Click="UDPdisconnectButton_Click" />
            <Button  x:Name="getPoseButton" Content="获取姿态"      FontSize="14" Foreground="White"    HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="80" BorderBrush="#FFDDDDDD" Background="#FF263851" Margin="31,139,0,0" Click="getPoseButton_Click" />
            <Label  Content="机器人执行指令通讯：" FontSize="14" Foreground="White"  HorizontalAlignment="Left" Margin="10,178,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.558,0.963" Height="28" Width="161"/>

        </Grid>

    </Grid>
</Window>
