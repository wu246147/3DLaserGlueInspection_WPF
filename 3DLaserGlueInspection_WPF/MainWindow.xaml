                Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="0,0,0,2" />

            <Border BorderBrush="Gray" BorderThickness="0,0,0,2" />

            <TextBlock
                Width="25"
                Height="26"
                Margin="5,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="Assets/Fonts/#iconfont"
                FontSize="22"
                Foreground="#0078DC"
                Text="&#xE600;" />

            <Label
                Height="38"
                Margin="35,0,0,0"
                HorizontalAlignment="Left"
                Content="{x:Static resx:LanguageDict.DetList}"
                FontSize="14"
                Foreground="White" />
            <TabControl
                x:Name="resultTabControl"
                Grid.Row="1"
                Background="#00000000"
                BorderBrush="#FF2A3440"
                Foreground="White"
                SelectionChanged="TabControl_SelectionChanged">
                <TabItem
                    Background="#FF2A3440"
                    FontSize="14"
                    Foreground="White"
                    Header="{x:Static resx:LanguageDict.PictureList}"
                    Template="{StaticResource TabItemTemplate}">
                    <Grid Background="#FF2A3440">
                        <DataGrid
                            x:Name="_2DResultDataGrid"
                            AlternationCount="2"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CellStyle="{StaticResource DataGridCellStyle}"
                            ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Hidden"
                            IsReadOnly="True"
                            ItemsSource="{Binding ImageResultRecords}"
                            RowStyle="{StaticResource LogDataGridRowStyle}"
                            SelectedCellsChanged="_2DResultDataGrid_SelectedCellsChanged"
                            SelectionMode="Single"
                            SelectionUnit ="Cell"
                            VerticalScrollBarVisibility="Auto"
                            CanUserSortColumns="False"
                            >
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Cam1}"
                                    Header="{x:Static resx:LanguageDict.Cam1}"
                                    HeaderStringFormat="{}{0} 1" >

                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                            <Setter Property="Foreground"
                            Value="{Binding Cam1Result,
                            Converter={StaticResource ResultColor}}" />
                                        </Style>
                                    </DataGridTextColumn.CellStyle>


                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Cam2}"
                                    Header="{x:Static resx:LanguageDict.Cam1}"
                                    HeaderStringFormat="{}{0} 2">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                            <Setter Property="Foreground"
Value="{Binding Cam2Result,
Converter={StaticResource ResultColor}}" />
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Cam3}"
                                    Header="{x:Static resx:LanguageDict.Cam1}"
                                    HeaderStringFormat="{}{0} 3">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                            <Setter Property="Foreground"
Value="{Binding Cam3Result,
Converter={StaticResource ResultColor}}" />
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Cam4}"
                                    Header="{x:Static resx:LanguageDict.Cam1}"
                                    HeaderStringFormat="{}{0} 4" >
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}">
                                            <Setter Property="Foreground"
Value="{Binding Cam4Result,
Converter={StaticResource ResultColor}}" />
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem
                    Background="#FF2A3440"
                    FontSize="14"
                    Foreground="White"
                    Header="{x:Static resx:LanguageDict.ProductList}"
                    Template="{StaticResource TabItemTemplate}">
                    <Grid Background="#FF2A3440">
