        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="747*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="TopMian"
            Height="60"
            VerticalAlignment="Top"
            Background="#FF242B35"
            MouseLeftButtonDown="TopMain_MouseLeftBtnDown">

            <StackPanel Margin="0,0,178,0" Orientation="Horizontal">
                <Label  Width="25"
                    Height="48"/>
                <Image
                    Width="102"
                    Height="48"
                    RenderTransformOrigin="-0.09,-0.057"
                    
                    Source="/Icon/LOGO.png" 
                     />
                <Label
                    x:Name="Lable_Title"
                    Width="350"
                    Height="42"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    Background="#FF242B35"
                    BorderBrush="{x:Null}"
