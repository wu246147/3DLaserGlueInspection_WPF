            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="583*" />
                <ColumnDefinition Width="584*" />
            </Grid.ColumnDefinitions>
            <Grid
                Grid.ColumnSpan="2"
                Width="244"
                HorizontalAlignment="Left" />
            <Grid
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Width="812"
                Margin="154,0,0,0"
                HorizontalAlignment="Left" />
            <Border
                Width="25"
                Height="25"
                Margin="25,67,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Blue"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="25">
                <Border.Effect>
                    <BlurEffect Radius="5" />
                </Border.Effect>
            </Border>
            <Border
                Width="25"
                Height="25"
                Margin="25,307,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Gray"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="25">
                <Border.Effect>
                    <BlurEffect Radius="5" />
                </Border.Effect>
            </Border>
            <Border
