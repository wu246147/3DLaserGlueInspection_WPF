                    Foreground="White" />
                <Label
                    Grid.Row="1"
                    Margin="0,122,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Content="{x:Static resx:LanguageDict.Robot }"
                    FontSize="14"
                    Foreground="White" />
                <Label
                    Grid.Row="1"
                    Margin="213,122,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="{x:Static resx:LanguageDict.SoftwareRun }"
                    FontSize="14"
                    Foreground="White" />
                <Label
                    Grid.Row="1"
                    Margin="43,122,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="{x:Static resx:LanguageDict.Cam1 }"
                    FontSize="14"
                    Foreground="White" />
            </Grid>

            <!--  Log bar  -->
            <Grid
                Grid.Column="2"
                Margin="5,0,10,0"
                Background="#FF2A3440">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*" />
                    <RowDefinition Height="154*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="Gray" BorderThickness="0,0,0,2" />
                <TextBlock
                    Width="25"
                    Height="26"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="Assets/Fonts/#iconfont"
                    FontSize="22"
                    Foreground="#0078DC"
                    Text="&#xE654;" />

                <Label
                    Margin="35,2,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="{x:Static resx:LanguageDict.LogInfo}"
                    FontSize="14"
                    Foreground="White" />
                <DataGrid
                    x:Name="DataGridLog"
                    Grid.Row="1"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    CellStyle="{StaticResource DataGridCellStyle}"
                    ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    HorizontalScrollBarVisibility="Hidden"
                    IsReadOnly="True"
                    ItemsSource="{Binding LogRecords}"
                    RowStyle="{StaticResource LogDataGridRowStyle}"
                    VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="170"
                            Binding="{Binding LogTime, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"
                            Foreground="White"
                            Header="{x:Static resx:LanguageDict.Time}" />
                        <!--<DataGridTextColumn Header="信息" Binding="{Binding LogInfo}" Width="*" Foreground="White"/>-->
                        <DataGridTemplateColumn
                            Width="*"
                            CellTemplate="{StaticResource TextDataTemplate}"
                            Header="{x:Static resx:LanguageDict.Info}" />

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>


