                    Click="btnMin_Click"
                    Content="&#xE65A;"
                    Style="{StaticResource WindowControlButtonStyle}" />
                <Button
                    Click="btnMax_Click"
                    Content="&#xE653;"
                    Style="{StaticResource WindowControlButtonStyle}" />
                <Button
                    Click="btnClose_Click"
                    Content="&#xECA0;"
                    Style="{StaticResource WindowControlButtonStyle}" />

            </StackPanel>

        </Grid>
        <!--  Menu bar  -->

        <!--  Info bar  -->
