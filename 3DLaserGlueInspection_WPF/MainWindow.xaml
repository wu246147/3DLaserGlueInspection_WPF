                <Grid.RowDefinitions>
                    <RowDefinition Height="30*" />
                    <RowDefinition Height="158*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="Gray" BorderThickness="0,0,0,2" />
                <TextBlock
                    Width="25"
                    Height="26"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="Assets/Fonts/#iconfont"
                    FontSize="22"
                    Foreground="#0078DC"
                    Text="&#xE651;" />

                <Border
                    x:Name="BorderCam"
                    Grid.Row="1"
                    Width="50"
                    Height="50"
                    Margin="37,40,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{Binding camCommunicationLabelColorControl}"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="50">
                    <Border.Effect>
                        <BlurEffect Radius="10" />
                    </Border.Effect>
                </Border>
                <Border
                    x:Name="BorderSoftware"
                    Grid.Row="1"
                    Width="50"
                    Height="50"
                    Margin="221,40,0,0"
