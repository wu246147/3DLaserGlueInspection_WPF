                Margin="20,0,0,0"
                HorizontalAlignment="Left"
                Content="{x:Static resx:LanguageDict.Time }"
                ContentStringFormat="{}{0} :"
                FontSize="14"
                Foreground="#FFFDFEFF" />
            <Label
                Grid.Column="4"
                Margin="20,0,0,0"
