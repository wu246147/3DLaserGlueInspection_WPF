                FontSize="14"
                Foreground="#FFFDFEFF" />
            <Label
                Grid.Column="2"
                Margin="20,0,0,0"
                HorizontalAlignment="Left"
                Content="VIN："
                FontSize="14"
                Foreground="#FFFDFEFF" />
            <Label
