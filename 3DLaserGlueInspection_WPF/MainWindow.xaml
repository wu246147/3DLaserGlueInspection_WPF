                    ContentStringFormat="{}   {0} 1.8.1 "
                    FontSize="22"
                    Foreground="#FF1679D0" />

            </StackPanel>
            <!--</Viewbox>-->

            <!--<Viewbox HorizontalAlignment="Right">-->
            <StackPanel
