                <RowDefinition Height="151*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230                                   " />
                <ColumnDefinition Width="325" />
                <ColumnDefinition Width="877*" />
            </Grid.ColumnDefinitions>

            <!--  Control bar  -->
            <Grid Margin="0,0,10,0" Background="#FF2A3440">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border BorderBrush="Gray" BorderThickness="0,0,0,2" />
                <Label
                    Margin="35,0,0,0"
                    HorizontalAlignment="Left"
                    Content="{x:Static resx:LanguageDict.ControlButton }"
                    FontSize="14"
                    Foreground="White" />
                <!--<TextBlock Text="{Binding buttonRunTagControl}" FontSize="22"
                    VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="Assets/Fonts/#iconfont" Foreground="#0078DC" Margin="5,0,0,0" Width="25" Height="26"/>-->
                <TextBlock
