                Content="{x:Static resx:LanguageDict.Simul}"
                Foreground="White"
                IsChecked="False"
                Visibility="Hidden"
                Unchecked="simulationCheck_Click" />
            <TextBox
                x:Name="simulationPath"
                Width="108"
                Margin="186,0,0,0"
                HorizontalAlignment="Left"
                Background="#FF2A3440"
                Foreground="White"
                TextChanged="simulationPath_TextChanged"
                Visibility="Hidden"
                TextWrapping="Wrap" />

        </Grid>
        <Grid
            Height="48"
            Margin="0,65,0,0"
            VerticalAlignment="Top"
            Background="#FF3C4451">
            <Menu
                Margin="25,0,0,0"
                HorizontalAlignment="Left"
                Background="#FF3C4451"
                Foreground="#FFFDFEFF" Height="48">
                
                <Menu.Resources>
                    <!-- 设置横向菜单项的 Padding -->
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Padding" Value="15,6"/>
                    </Style>
                </Menu.Resources>

                <MenuItem
                    x:Name="menuItem_custom"
                    Height="50"
                    
                    Header="{x:Static resx:LanguageDict.User}">
                    <MenuItem
                        x:Name="MenuItem_changePasswordSetting"
                        BorderBrush="#00000000"
                        BorderThickness="0"
                        Click="MenuItem_changePasswordSetting_Click"
                        Foreground="Black"
                        Header="{x:Static resx:LanguageDict.ChangePassWork}" />
                </MenuItem>
                <MenuItem x:Name="MenuItem_signalSetting" Header="{x:Static resx:LanguageDict.SignalDistribution}" Height="50">
                    <MenuItem
                        x:Name="MenuItem_signalDistributionSetting"
                        BorderBrush="#00000000"
                        BorderThickness="0"
                        Foreground="Black"
                        Header="{x:Static resx:LanguageDict.SignalDistribution}"
                        Visibility="Collapsed" />
                    <MenuItem
                        x:Name="MenuItem_computerSetting"
                        BorderBrush="#00000000"
                        BorderThickness="0"
                        Foreground="Black"
                        Header="{x:Static resx:LanguageDict.PLCSetting}"
                        Visibility="Collapsed" />
                    <MenuItem
                        x:Name="MenuItem_robotSetting"
                        BorderBrush="#00000000"
                        BorderThickness="0"
                        Click="MenuItem_robotSetting_signalSetting_Click"
                        Foreground="Black"
                        Header="{x:Static resx:LanguageDict.RobotSetting}" />
                </MenuItem>
                <MenuItem
                    x:Name="MenuItem_camSetting"
                    Click="MenuItem_camSetting_Click"
                    Header="{x:Static resx:LanguageDict.CamSetting}" Height="50"/>
                <MenuItem
                    x:Name="MenuItem_productSetting"
                    Click="MenuItem_productSetting_Click"
                    Header="{x:Static resx:LanguageDict.ProductSetting}" Height="50"/>
                <MenuItem
                    x:Name="MenuItem_paraSetting"
                    Click="MenuItem_paraSetting_Click"
                    Header="{x:Static resx:LanguageDict.ParaSetting}" Height="50"/>
                <MenuItem
                    x:Name="MenuItem_languageSetting"
                    BorderBrush="#FF3C4451"
                    Header="{x:Static resx:LanguageDict.Language}" Height="50" >

                    <MenuItem
                        x:Name="MenuItem_chineseLanguage"
                        BorderBrush="#00000000"
                        BorderThickness="0"
                        Foreground="Black"
                        Header="{x:Static resx:LanguageDict.Chinese}" IsCheckable="True" Click="MenuItem_chineseLanguage_Click"/>
                    <MenuItem
                        x:Name="MenuItem_englishLanguage"
                        BorderBrush="#00000000"
                        BorderThickness="0"
                        Foreground="Black"
                        Header="English"  IsCheckable="True" Click="MenuItem_englishLanguage_Click"  />
                </MenuItem>
            </Menu>
        </Grid>

    </Grid>

</Window>