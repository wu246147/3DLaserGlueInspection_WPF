                    CornerRadius="50">
                    <Border.Effect>
                        <BlurEffect Radius="10" />
                    </Border.Effect>
                </Border>
                <Label
                    Margin="35,2,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="{x:Static resx:LanguageDict.MonitoringCommunication }"
