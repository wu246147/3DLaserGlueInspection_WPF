                                    Foreground="White"
                                    Header="{x:Static resx:LanguageDict.ProductID}" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding GlueV}"
                                    Foreground="White"
                                    Header="{x:Static resx:LanguageDict.GlueV}" />              
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding GlueLenth}"
                                    Foreground="White"
                                    Header="{x:Static resx:LanguageDict.GlueLenth}" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding CarResult}"
                                    Foreground="White"
                                    Header="{x:Static resx:LanguageDict.Result}" />

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
