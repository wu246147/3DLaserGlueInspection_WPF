<Window x:Class="_3DLaserGlueInspection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:cvt="clr-namespace:RAIVASCS.Converter"


        xmlns:local="clr-namespace:_3DLaserGlueInspection_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="1040.4" Width="1918" WindowStyle="None"  WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        MaxWidth="{StaticResource {x:Static SystemParameters.MaximizedPrimaryScreenWidthKey}}"
        MaxHeight="{StaticResource {x:Static SystemParameters.MaximizedPrimaryScreenHeightKey}}" 
        MinHeight="800"
        MinWidth="1600"
        Icon="/Icon/LOGO2.ico" Closing="Window_Closing" Background="{x:Null}" WindowState="Maximized">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Styles/DefaultStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cvt:FloatToPercentConverter x:Key="PercentConverter"/>
            <cvt:VisibilityToWidthConverter x:Key="VisibilityToWidthConverter"/>

        </ResourceDictionary>
    </Window.Resources>


    <Grid Background="#FF242B35" RenderTransformOrigin="0.499,0.53">
        <!--Title bar-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="747*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="TopMian" Background="#FF242B35" Height="60" VerticalAlignment="Top" MouseLeftButtonDown="TopMain_MouseLeftBtnDown" >

            <StackPanel Orientation="Horizontal" Margin="0,0,178,0">
                <Image Margin="10,0,0,0" RenderTransformOrigin="-0.09,-0.057" Source="/Icon/LOGO.png"  VerticalAlignment="Center" Height="22" Width="120" HorizontalAlignment="Left" />
                <Label x:Name="Lable_Title" Width="309" Height="60"
                    Foreground="#FF1679D0" Background="#FF242B35" VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Left" FontSize="22" BorderBrush="{x:Null}" VerticalAlignment="Center" Margin="0,-5,0,0" Content="AI 3D视觉涂胶检测系统" />

            </StackPanel>
            <!--</Viewbox>-->

            <!--<Viewbox HorizontalAlignment="Right">-->
            <StackPanel Orientation="Horizontal" Margin="0,12,9,12" HorizontalAlignment="Right" Width="120" VerticalAlignment="Top">

                <Button Style="{StaticResource WindowControlButtonStyle}" Content="&#xe65a;" Click="btnMin_Click"/>
                <Button Style="{StaticResource WindowControlButtonStyle}" Content="&#xe653;" Click="btnMax_Click"/>
                <Button Style="{StaticResource WindowControlButtonStyle}" Content="&#xeca0;" Click="btnClose_Click"/>

            </StackPanel>

        </Grid>
        <!--Menu bar-->
        <Menu Height="30" VerticalAlignment="Top" Grid.ColumnSpan="4" Margin="0,60,0,0" Background="#FF3C4451" Foreground="#FFFDFEFF">
            <MenuItem x:Name="menuItem_custom" Header="用户" Height="30">
                <MenuItem x:Name="MenuItem_changePasswordSetting" Header="修改密码" BorderThickness="0" BorderBrush="#00000000" Foreground="Black"/>
            </MenuItem>
            <MenuItem x:Name="MenuItem_signalSetting" Header="信号设置">
                <MenuItem x:Name="MenuItem_signalDistributionSetting" Header="信号分配" BorderThickness="0" BorderBrush="#00000000" Foreground="Black"/>
                <MenuItem x:Name="MenuItem_computerSetting" Header="上位机设置" BorderThickness="0" BorderBrush="#00000000" Foreground="Black"/>
                <MenuItem x:Name="MenuItem_robotSetting" Header="机器人设置" BorderThickness="0" BorderBrush="#00000000" Foreground="Black"/>
            </MenuItem>
            <MenuItem x:Name="MenuItem_camSetting" Header="相机设置"/>
            <MenuItem x:Name="MenuItem_productSetting" Header="产品设置"/>
            <MenuItem x:Name="MenuItem_paraSetting" Header="参数设置"/>
            <MenuItem x:Name="MenuItem_languageSetting" Header="语言" BorderBrush="#FF3C4451">
                <MenuItem x:Name="MenuItem_chineseLanguage" Header="中文" BorderThickness="0" BorderBrush="#00000000" Foreground="Black"/>
                <MenuItem x:Name="MenuItem_englishLanguage" Header="英文" BorderThickness="0" BorderBrush="#00000000" Foreground="Black"/>
            </MenuItem>
        </Menu>

        <!--Info bar-->
        <Grid Height="65" Margin="10,102,426,0" VerticalAlignment="Top" Background="#FF2A3440">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="产品型号：" Margin="20,0,0,0" Foreground="#FFFDFEFF" RenderTransformOrigin="0.025,1.242" Height="25" HorizontalAlignment="Left" Width="71"/>
            <Label x:Name="LabelName" Content="--" Margin="66,0,26,0" Foreground="#FFFDFEFF" Grid.Column="1" Height="25"/>
            <Label x:Name="LabelProductID" Content="--" Margin="84,0,37,0" Foreground="#FFFDFEFF" Height="25"/>
            <Label Content="名称：" Margin="20,0,0,0" Foreground="#FFFDFEFF" Grid.Column="1" Height="25" HorizontalAlignment="Left" Width="46"/>
            <Label Content="时间：" Margin="20,0,0,0" Foreground="#FFFDFEFF" Grid.Column="3" Height="25" HorizontalAlignment="Left" Width="48"/>
            <Label x:Name="LabelTime" Content="-----------------" Foreground="#FFFDFEFF" Grid.Column="3" Height="25" HorizontalAlignment="Left" Width="145" Margin="68,0,0,0"/>
            <Label x:Name="LabelResult" Content="OK" Margin="87,0,0,0" Foreground="#FF06BD00" FontSize="48" Background="Transparent" FontWeight="Bold" Grid.Column="4" Height="65" HorizontalAlignment="Left" Width="100"/>
            <Label Content="检测结果:" Margin="20,0,0,0" Foreground="#FFFDFEFF" Grid.Column="4" Height="25" HorizontalAlignment="Left" Width="82"/>
            <Label x:Name="LabelVIN" Content="-----------------" Foreground="#FFFDFEFF" Grid.Column="2" Height="25" HorizontalAlignment="Left" Width="120" Margin="63,0,0,0"/>
            <Label Content="VIN：" Margin="20,0,0,0" Foreground="#FFFDFEFF" Grid.Column="2" Height="25" HorizontalAlignment="Left" Width="41"/>

        </Grid>


        <!--View bar-->
        <Grid Margin="10,178,426,245" Background="#FF2A3440">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="157"/>
                <ColumnDefinition Width="583*"/>
                <ColumnDefinition Width="584*"/>
            </Grid.ColumnDefinitions>
            <Grid HorizontalAlignment="Left" Width="244" Grid.ColumnSpan="2"/>
            <Grid HorizontalAlignment="Left" Width="812" Margin="154,0,0,0" Grid.ColumnSpan="2" Grid.Column="1"/>
            <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left"  Margin="37,67,0,0" VerticalAlignment="Top" CornerRadius="25" Height="25" Width="25" Background="Blue">
                <Border.Effect>
                    <BlurEffect Radius="5"/>
                </Border.Effect>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left"  Margin="37,307,0,0" VerticalAlignment="Top" CornerRadius="25" Height="25" Width="25" Background="Gray">
                <Border.Effect>
                    <BlurEffect Radius="5"/>
                </Border.Effect>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left"  Margin="37,226,0,0" VerticalAlignment="Top" CornerRadius="25" Height="25" Width="25" Background="Red">
                <Border.Effect>
                    <BlurEffect Radius="5"/>
                </Border.Effect>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left"  Margin="37,145,0,0" VerticalAlignment="Top" CornerRadius="25" Height="25" Width="25" Background="LightGreen">
                <Border.Effect>
                    <BlurEffect Radius="5"/>
                </Border.Effect>
            </Border>
            <Label Content="待检" HorizontalAlignment="Left" Margin="78,67,0,0" VerticalAlignment="Top" Foreground="White" Height="25" Width="34"/>
            <Label Content="不检" HorizontalAlignment="Left" Margin="78,307,0,0" VerticalAlignment="Top" Foreground="White" Height="25" Width="34"/>
            <Label Content="异常" HorizontalAlignment="Left" Margin="78,226,0,0" VerticalAlignment="Top" Foreground="White" Height="25" Width="34"/>
            <Label Content="正常" HorizontalAlignment="Left" Margin="78,145,0,0" VerticalAlignment="Top" Foreground="White" Height="25" Width="34"/>
            <Grid x:Name="GridTotalResultImage" Grid.Column="1" Background="#FF373737" Margin="0,0,10,0"/>
            <Grid x:Name="GridCheckImage" Grid.Column="2" Margin="10,0,0,0" Background="#FF373737"/>
        </Grid>

        <!--State bar-->
        <Grid Margin="10,0,426,10" Background="#FF242B35" Height="219" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="151*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="325"/>
                <ColumnDefinition Width="877*"/>
            </Grid.ColumnDefinitions>

            <!--Control bar -->
            <Grid Background="#FF2A3440" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Border BorderBrush="Gray" BorderThickness="0,0,0,2"/>
                <Label Content="控制按键" HorizontalAlignment="Left" Margin="35,0,0,0" Foreground="White" Height="26" Width="58"/>
                <TextBlock Text="&#xE67E;" FontSize="22"
                    VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="Assets/Fonts/#iconfont" Foreground="#0078DC" Margin="5,0,0,0" Width="25" Height="26"/>

                <Button x:Name="ButtonRun" Grid.Row="1" Content="启动" Tag="&#xE658;" FontFamily="../Assets/Fonts/#iconfont" Template="{StaticResource IconTextButtonTemplate}" 
                                Width="150" HorizontalAlignment="Center" Margin="0,64,0,63"/>

            </Grid>

            <!--Communication bar -->
            <Grid Grid.Column="1" Background="#FF2A3440" Margin="10,0,11,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="158*"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="Gray" BorderThickness="0,0,0,2"/>
                <TextBlock Text="&#xe651;" FontSize="22"
                    VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="Assets/Fonts/#iconfont" Foreground="#0078DC" Margin="5,0,0,0" Width="25" Height="26"/>

                <Border x:Name="BorderCam" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left"  Margin="37,32,0,0" VerticalAlignment="Top" CornerRadius="50" Height="50" Width="50" Background="Gray" Grid.Row="1">
                    <Border.Effect>
                        <BlurEffect Radius="10"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="BorderSoftware" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left"  Margin="221,32,0,0" VerticalAlignment="Top"  CornerRadius="50" Height="50" Width="50" Background="Gray" Grid.Row="1">
                    <Border.Effect>
                        <BlurEffect Radius="10"/>
                    </Border.Effect>
                </Border>
                <Border x:Name="BorderRobot" BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Margin="127,32,0,0" VerticalAlignment="Top"  CornerRadius="50" Height="50" Width="50" Background="Gray" Grid.Row="1">
                    <Border.Effect>
                        <BlurEffect Radius="10"/>
                    </Border.Effect>
                </Border>
                <Label Content="控通讯监" HorizontalAlignment="Left" Margin="35,2,0,0" VerticalAlignment="Top" Foreground="White"/>
                <Label Content="机器人" HorizontalAlignment="Center" Margin="0,110,0,0" Grid.Row="1" VerticalAlignment="Top" Foreground="White"/>
                <Label Content="软件运行" HorizontalAlignment="Left" Margin="229,110,0,0" Grid.Row="1" VerticalAlignment="Top" Foreground="White"/>
                <Label Content="相机" HorizontalAlignment="Left" Margin="44,110,0,0" Grid.Row="1" VerticalAlignment="Top" Foreground="White"/>
            </Grid>

            <!--Log bar -->
            <Grid Grid.Column="2" Background="#FF2A3440" Margin="5,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30*"/>
                    <RowDefinition Height="154*"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="Gray" BorderThickness="0,0,0,2"/>
                <TextBlock Text="&#xe654;" FontSize="22"
                    VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="Assets/Fonts/#iconfont" Foreground="#0078DC" Margin="5,0,0,0" Width="25" Height="26"/>

                <Label Content="日志信息" HorizontalAlignment="Left" Margin="35,2,0,0" VerticalAlignment="Top" Foreground="White"/>
                <DataGrid x:Name="DataGridLog" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" AlternationCount="2"
                  GridLinesVisibility="None" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" Background="Transparent" BorderThickness="0" 
                  ItemsSource="{Binding MainModel.Logs}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}" 
                  CellStyle="{StaticResource DataGridCellStyle}" RowStyle="{StaticResource LogDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="200" Foreground="White"/>
                        <DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="*" Foreground="White"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>


        </Grid>

        <!--Result bar-->
        <Grid Margin="0,102,10,10" Background="#FF2A3440" HorizontalAlignment="Right" Width="404">
            <Grid.RowDefinitions>
                <RowDefinition Height="37"/>
                <RowDefinition/>
                <RowDefinition Height="187.4"/>
            </Grid.RowDefinitions>
            <lvc:PieChart x:Name="PieChartResult"  Grid.Row="2" InnerRadius="55
                          " Height="163" VerticalAlignment="Top" Margin="218,14,-6,0">
                <lvc:PieChart.Series>
                    <lvc:PieSeries Values="456" Fill="LightGreen" DataLabels="True" Title="OK" Stroke="White"/>
                    <lvc:PieSeries Values="36" Fill="Red" DataLabels="True" Title="NG" Stroke="White"/>
                </lvc:PieChart.Series>
            </lvc:PieChart>
            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="0,0,0,2"/>

            <Border BorderBrush="Gray" BorderThickness="0,0,0,2"/>
            <TextBlock Text="&#xE600;" FontSize="22"
                    VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="Assets/Fonts/#iconfont" Foreground="#0078DC" Margin="5,0,0,0" Width="25" Height="26"/>

            <Label Content="检测列表" HorizontalAlignment="Left" Margin="35,0,0,0" Foreground="White" Height="38" Width="79"/>
            <TabControl Grid.Row="1" Background="#00000000" Foreground="White" BorderBrush="#FF2A3440">
                <TabItem Template="{StaticResource TabItemTemplate}" Header="图片列表" Foreground="White" Background="#FF2A3440">
                    <Grid Background="#FF2A3440">
                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" AlternationCount="2"
              GridLinesVisibility="None" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" Background="Transparent" BorderThickness="0" 
              ItemsSource="{Binding MainModel.Logs}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}" 
              CellStyle="{StaticResource DataGridCellStyle}" RowStyle="{StaticResource LogDataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="相机1" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="*" Foreground="White"/>
                                <DataGridTextColumn Header="相机2" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="*" Foreground="White"/>
                                <DataGridTextColumn Header="相机3" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="*" Foreground="White"/>
                                <DataGridTextColumn Header="相机4" Binding="{Binding Message}" Width="*" Foreground="White"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Template="{StaticResource TabItemTemplate}" Header="产品列表" Foreground="White" Background="#FF2A3440">
                    <Grid Background="#FF2A3440">
                        <DataGrid x:Name="DataGridCarList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" AlternationCount="2"
                          GridLinesVisibility="None" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden" Background="Transparent" BorderThickness="0" 
                          ItemsSource="{Binding MainModel.Logs}" ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}" 
                          CellStyle="{StaticResource DataGridCellStyle}" RowStyle="{StaticResource LogDataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="200" Foreground="White"/>
                                <DataGridTextColumn Header="产品号" Binding="{Binding Message}" Width="*" Foreground="White"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding Message}" Width="*" Foreground="White"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                </TabItem>
            </TabControl>

            <Label  Grid.Row="2" x:Name="LabelResultPercentage" Content="98.86%" Margin="267,0,43,0" Foreground="White" FontSize="22" FontWeight="Bold" RenderTransformOrigin="0.351,0.272" Height="47"/>
            <Label Content="产量：" HorizontalAlignment="Left" Margin="10,33,0,0" Grid.Row="2" VerticalAlignment="Top" Foreground="White" Height="26" Width="46"/>
            <Label x:Name="LabelNGCount" Content="" HorizontalAlignment="Left" Margin="82,137,0,0" Grid.Row="2" VerticalAlignment="Top" Foreground="White" Background="#FF3C4451" Width="136" Height="25"/>
            <Label x:Name="LabelOKCount" Content="" HorizontalAlignment="Left" Margin="82,83,0,0" Grid.Row="2" Foreground="White" Background="#FF3C4451" Width="136" Height="26" VerticalAlignment="Top"/>
            <Label Content="NG数：" HorizontalAlignment="Left" Margin="10,137,0,0" Grid.Row="2" VerticalAlignment="Top" Foreground="White" Height="25" Width="54"/>
            <Label Content="OK数：" HorizontalAlignment="Left" Margin="10,83,0,0" Grid.Row="2" Foreground="White" Height="26" Width="51" VerticalAlignment="Top"/>
            <Label x:Name="LabelTotalCount" Content="" HorizontalAlignment="Left" Margin="82,33,0,0" Grid.Row="2" VerticalAlignment="Top" Foreground="White" Background="#FF3C4451" Width="136" Height="26"/>

        </Grid>

    </Grid>

</Window>