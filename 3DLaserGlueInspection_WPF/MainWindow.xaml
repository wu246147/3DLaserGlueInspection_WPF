                    Height="26"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="Assets/Fonts/#iconfont"
                    FontSize="22"
                    Foreground="#0078DC"
                    Text="&#xE67E;" />
